{
  "name": "ajith-kumar-racing",
  "version": "1.0.0",
  "description": "Ajith Kumar Racing (AKR) - Premium International Motorsport Platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "client": "npm run dev --workspace=client",
    "server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "seed": "npm run seed --workspace=server",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
